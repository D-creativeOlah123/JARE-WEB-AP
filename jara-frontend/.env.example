# Base URL of the Jara backend API.
#
# Dev:   http://localhost:5000/api  (set in jara-frontend/.env)
# Prod:  https://<your-render-service>.onrender.com/api
#        (set in the Vercel project's env vars — Project → Settings →
#         Environment Variables — for Production and Preview scopes)
#
# Trailing /api is required: every service file calls routes like
# `/auth/login`, `/transfers`, etc. and `axios.create({ baseURL })` joins
# the two.
VITE_API_URL=http://localhost:5000/api
