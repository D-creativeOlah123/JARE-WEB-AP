# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- Database ---
# MongoDB Atlas connection string. Get one at cloud.mongodb.com (free M0 tier).
# Replace <user>, <password>, <cluster>, and <db> below.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jara?retryWrites=true&w=majority

# --- CORS ---
# Comma-separated list of allowed origins. Vite dev usually 5173, sometimes
# falls back to 5174. Update when the frontend deploys.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- JWT ---
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-hex-string
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (Gmail SMTP) ---
# Enable 2FA on your Google account, then create an App Password:
#   https://myaccount.google.com/apppasswords
# Leave SMTP_USER/SMTP_PASS empty to use dev-mode fallback (OTPs logged +
# returned in the API response instead of being emailed).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Jara <no-reply@jara.app>

# --- Paystack (bank transfers) ---
# Get test key at https://dashboard.paystack.com/#/settings/developers
# Leave blank to use stub mode (mock account name, instant success).
PAYSTACK_SECRET_KEY=

# --- VTPass (airtime + data + bills) ---
# Register at https://www.vtpass.com/ (production) or sandbox.vtpass.com
# Leave blank to use stub mode (instant success + fake reference).
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
